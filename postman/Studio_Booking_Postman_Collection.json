{
  "info": {
    "name": "Studio Booking API",
    "description": "End-to-end API collection: authenticate, setup, credits, booking, waitlist, cancellation and promotion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "staff_username",
      "value": "staff"
    },
    {
      "key": "staff_password",
      "value": ""
    },
    {
      "key": "member1_username",
      "value": "member1"
    },
    {
      "key": "member1_password",
      "value": ""
    },
    {
      "key": "member2_username",
      "value": "member2"
    },
    {
      "key": "member2_password",
      "value": ""
    },
    {
      "key": "staff_token",
      "value": ""
    },
    {
      "key": "member1_token",
      "value": ""
    },
    {
      "key": "member2_token",
      "value": ""
    },
    {
      "key": "studio_id",
      "value": ""
    },
    {
      "key": "class_id",
      "value": ""
    },
    {
      "key": "member1_booking_id",
      "value": ""
    },
    {
      "key": "waitlist_entry_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login - Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{staff_username}}\",\n  \"password\": \"{{staff_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('staff_token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Member 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{member1_username}}\",\n  \"password\": \"{{member1_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('member1_token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Member 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{member2_username}}\",\n  \"password\": \"{{member2_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('member2_token', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Setup",
      "item": [
        {
          "name": "Create Studio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{staff_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/studios/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Studio\",\n  \"timezone\": \"Asia/Kolkata\",\n  \"cancellation_cutoff_hours\": 4\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('studio_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create One-Spot Class",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{staff_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/classes/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studio\": \"{{studio_id}}\",\n  \"start_time\": \"2026-09-01T10:00:00Z\",\n  \"duration_minutes\": 60,\n  \"spots\": 1,\n  \"credit_cost\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('class_id', pm.response.json().id);",
                  "pm.test('One spot', () => pm.expect(pm.response.json().spots).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Grant Credits - Member 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{staff_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/credit-packs/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member\": 2,\n  \"credits\": 20,\n  \"grant_date\": \"2026-08-19T10:00:00Z\",\n  \"expiry_date\": \"2026-09-19T10:00:00Z\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Grant Credits - Member 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{staff_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/credit-packs/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member\": 3,\n  \"credits\": 20,\n  \"grant_date\": \"2026-08-19T10:00:00Z\",\n  \"expiry_date\": \"2026-09-19T10:00:00Z\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Booking",
      "item": [
        {
          "name": "Check Member 1 Balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member1_token}}"
              }
            ],
            "url": "{{base_url}}/api/credits/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Balance >= 5', () => pm.expect(pm.response.json().balance).to.be.at.least(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Book Class - Member 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member1_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-member1-booking-001"
              }
            ],
            "url": "{{base_url}}/api/classes/{{class_id}}/book/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 200', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "const j=pm.response.json(); pm.collectionVariables.set('member1_booking_id',j.id);",
                  "pm.test('Confirmed', () => pm.expect(j.status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Class Is Full",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member1_token}}"
              }
            ],
            "url": "{{base_url}}/api/classes/{{class_id}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Available spots = 0', () => pm.expect(pm.response.json().available_spots).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Waitlist",
      "item": [
        {
          "name": "Join Waitlist - Member 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member2_token}}"
              }
            ],
            "url": "{{base_url}}/api/classes/{{class_id}}/waitlist/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('waitlist_entry_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Member 2 Waitlist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member2_token}}"
              }
            ],
            "url": "{{base_url}}/api/me/waitlist/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Entry exists', () => pm.expect(pm.response.json().length).to.be.greaterThan(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Cancellation and Promotion",
      "item": [
        {
          "name": "Cancel Member 1 Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member1_token}}"
              }
            ],
            "url": "{{base_url}}/api/bookings/{{member1_booking_id}}/cancel/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cancelled', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Member 2 Promotion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member2_token}}"
              }
            ],
            "url": "{{base_url}}/api/me/bookings/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const bs=pm.response.json(); const b=bs.find(x=>x.fitness_class==pm.collectionVariables.get('class_id') && x.status==='CONFIRMED');",
                  "pm.test('Promoted booking exists', () => pm.expect(b).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Waitlist Empty",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member2_token}}"
              }
            ],
            "url": "{{base_url}}/api/me/waitlist/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Waitlist empty', () => pm.expect(pm.response.json().length).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Member 1 Refund",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member1_token}}"
              }
            ],
            "url": "{{base_url}}/api/credits/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Balance restored to 20', () => pm.expect(pm.response.json().balance).to.eql(20));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Credit Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{member1_token}}"
              }
            ],
            "url": "{{base_url}}/api/credits/transactions/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const tx=pm.response.json();",
                  "pm.test('GRANT exists', () => pm.expect(tx.some(x=>x.cause==='GRANT')).to.eql(true));",
                  "pm.test('BOOKING exists', () => pm.expect(tx.some(x=>x.cause==='BOOKING')).to.eql(true));",
                  "pm.test('REFUND exists', () => pm.expect(tx.some(x=>x.cause==='REFUND')).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}