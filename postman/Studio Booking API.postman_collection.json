			"name": "Authentication",
			"item": [
				{
					"name": "Login - Staff",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const responseData = pm.response.json();",
									"",
									"pm.test(\"Response contains token\", function () {",
									"    pm.expect(responseData).to.have.property(\"token\");",
									"});",
									"",
									"pm.test(\"Response contains user\", function () {",
									"    pm.expect(responseData).to.have.property(\"user\");",
									"});",
									"",
									"pm.collectionVariables.set(\"staff_token\", responseData.token);",
									"pm.collectionVariables.set(\"auth_token\", responseData.token);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
